{
  "name": "concord-docs",
  "main": "worker.js",
  "compatibility_date": "2025-01-01",
  "routes": [{ "pattern": "docs.concordstudios.lol", "custom_domain": true }],
  // Non-secret values only. The client secret must NOT live here (use `wrangler secret put`).
  "vars": {
    "OWNER_DISCORD_ID": "CHANGE_ME",
    "DISCORD_CLIENT_ID": "CHANGE_ME"
  },
  "d1_databases": [{ "binding": "DB", "database_name": "concord-docs" }]
}
